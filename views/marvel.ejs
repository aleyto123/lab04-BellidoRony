<%- include('partials/header', { title: 'Marvel - Universe Database', url: '/marvel' }) %>
<%- include('partials/navbar', { url: '/marvel' }) %>

<main>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1 class="hero-title">Base de Datos Marvel</h1>
            <p class="hero-subtitle">Registra y gestiona personajes del universo Marvel. Crea tu propia colección de superhéroes y villanos.</p>
        </div>
    </section>

    <!-- Contenido Principal -->
    <section class="section">
        <div class="container">
            <div class="two-column">
                <!-- Formulario de Registro -->
                <div class="form-card">
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
                        <div style="font-size: 1.8rem;">⚡</div>
                        <h2 style="margin: 0;">Registrar Personaje</h2>
                    </div>
                    
                    <form action="/marvel" method="POST" class="marvel-form">
                        <!-- Nombre -->
                        <div class="form-group">
                            <label for="nombre" class="form-label">Nombre del Personaje</label>
                            <input 
                                type="text" 
                                id="nombre" 
                                name="nombre" 
                                class="form-input" 
                                placeholder="ej: Spider-Man"
                                required
                            >
                        </div>

                        <!-- Nombre Real (cambiar de alias a nombreReal) -->
                        <div class="form-group">
                            <label for="nombreReal" class="form-label">Nombre Real / Alias</label>
                            <input 
                                type="text" 
                                id="nombreReal" 
                                name="nombreReal" 
                                class="form-input" 
                                placeholder="ej: Peter Parker"
                                required
                            >
                        </div>

                        <!-- Equipo -->
                        <div class="form-group">
                            <label for="equipo" class="form-label">Equipo / Afiliación</label>
                            <input 
                                type="text" 
                                id="equipo" 
                                name="equipo" 
                                class="form-input" 
                                placeholder="ej: Vengadores"
                                required
                            >
                        </div>

                        <!-- Poder Principal -->
                        <div class="form-group">
                            <label for="poder" class="form-label">Poder Principal</label>
                            <input 
                                type="text" 
                                id="poder" 
                                name="poder" 
                                class="form-input" 
                                placeholder="ej: Super fuerza, Telaraña"
                                required
                            >
                        </div>

                        <!-- Universo -->
                        <div class="form-group">
                            <label for="universo" class="form-label">Universo MCU / Cómics</label>
                            <input 
                                type="text" 
                                id="universo" 
                                name="universo" 
                                class="form-input" 
                                placeholder="ej: MCU, Cómics, Ambos"
                                required
                            >
                        </div>

                        <!-- Descripción -->
                        <div class="form-group">
                            <label for="descripcion" class="form-label">Descripción</label>
                            <textarea 
                                id="descripcion" 
                                name="descripcion" 
                                class="form-textarea" 
                                placeholder="Describe brevemente al personaje, sus características principales..."
                                required
                            ></textarea>
                        </div>

                        <!-- Botón Submit -->
                        <button type="submit" class="btn btn-primary" style="width: 100%;">
                            <i data-lucide="plus"></i>
                            Registrar en la Base de Datos
                        </button>
                    </form>
                </div>

                <!-- Grid de Personajes -->
                <div>
                    <h2 style="margin-bottom: 1.5rem;">Personajes Registrados</h2>
                    
                    <% if (typeof characters === 'undefined' || characters.length === 0) { %>
                        <!-- Empty State -->
                        <div class="empty-state" style="background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 12px; padding: 2rem;">
                            <div class="empty-state-icon">🦸</div>
                            <h3 class="empty-state-title">Sin Personajes Registrados</h3>
                            <p class="empty-state-text">Aún no hay personajes en la base de datos. ¡Registra el primero!</p>
                        </div>
                    <% } else { %>
                        <!-- Grid de Tarjetas -->
                        <div style="display: grid; gap: 1rem;">
                            <% characters.forEach((char, index) => { %>
                                <div class="card">
                                    <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                                        <span class="badge badge-gold">#<%= index + 1 %></span>
                                        <span class="badge badge-red" style="white-space: nowrap;"><%= char.universo %></span>
                                    </div>
                                    <h3 style="color: var(--accent-red); margin-bottom: 0.25rem;"><%= char.nombre %></h3>
                                    <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
                                        <em><%= char.nombreReal %></em>
                                    </p>
                                    <p style="color: var(--text-light); margin-bottom: 1rem; font-size: 0.85rem; line-height: 1.5;">
                                        <%= char.descripcion %>
                                    </p>
                                    <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
                                        <p style="margin: 0.5rem 0; color: var(--text-light); font-size: 0.9rem;">
                                            <strong>Equipo:</strong> <%= char.equipo %>
                                        </p>
                                        <p style="margin: 0.5rem 0; color: var(--text-light); font-size: 0.9rem;">
                                            <strong>Poder:</strong> <span style="color: var(--accent-gold);"><%= char.poder %></span>
                                        </p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>

<script>
    lucide.createIcons();
</script>