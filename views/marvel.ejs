<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro de Personajes de Marvel</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
</head>
<body class="container">
  <h3 class="center-align red-text text-darken-2">Personajes de Marvel</h3>
  
  <div class="row">
    <!-- Formulario con 5 campos -->
    <form action="/marvel" method="POST" class="col s12 m4">
      <h5>Nuevo Personaje</h5>
      <div class="input-field">
        <input id="nombre" type="text" name="nombre" required>
        <label for="nombre">Nombre de Héroe/Villano</label>
      </div>
      <div class="input-field">
        <input id="alias" type="text" name="alias" required>
        <label for="alias">Alias / Nombre Real</label>
      </div>
      <div class="input-field">
        <input id="equipo" type="text" name="equipo" required>
        <label for="equipo">Equipo (ej. Avengers, X-Men)</label>
      </div>
      <div class="input-field">
        <input id="poder" type="text" name="poder" required>
        <label for="poder">Poder Principal</label>
      </div>
      <div class="input-field">
        <input id="universo" type="text" name="universo" required>
        <label for="universo">Universo (ej. Tierra-616)</label>
      </div>
      <button type="submit" class="waves-effect waves-light btn red darken-2">Registrar</button>
      <a href="/" class="waves-effect waves-light btn grey">Volver</a>
    </form>

    <!-- Tabla de registros -->
    <div class="col s12 m8">
      <h5>Lista de Personajes</h5>
      <% if (characters.length === 0) { %>
        <p class="grey-text">No hay personajes registrados en la memoria aún.</p>
      <% } else { %>
        <table class="striped highlight responsive-table">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Alias / Nombre Real</th>
              <th>Equipo</th>
              <th>Poder</th>
              <th>Universo</th>
            </tr>
          </thead>
          <tbody>
            <% characters.forEach(c => { %>
              <tr>
                <td><strong><%= c.nombre %></strong></td>
                <td><%= c.alias %></td>
                <td><%= c.equipo %></td>
                <td><%= c.poder %></td>
                <td><%= c.universo %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>